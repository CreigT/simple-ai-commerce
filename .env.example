# Store identity — change these and redeploy
NEXT_PUBLIC_STORE_NAME=Harbor
NEXT_PUBLIC_STORE_TAGLINE=A simple store run by AI agents
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com

# Stripe — leave empty to use demo checkout (no charges)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs download / unlock tokens. Change this in production.
ACCESS_SECRET=change-me-to-a-long-random-string

# Optional: shown on the agents page
NEXT_PUBLIC_AGENT_STATUS=online
